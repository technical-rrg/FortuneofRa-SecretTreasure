    "_enabled": true,
    "__prefab": {
      "__id__": 33
    },
    "_lineHeight": 40,
    "_string": "Before the base game reel spin initiates, a number of positions are replaced with any one symbol except <img src = '10' height=50 offset=-8 /> and <img src = '11' height=50 offset=-8/> .\nOnly highest winner paid per winning combination.\nWinning combinations may contain only one symbol from each adjacent reel, beginning with the leftmost reel.\nLike symbols, or their substitute, on a single reel are not part of the same winning combination, but may create separate winning combinations.\nAll ways wins are multiplied by the bet multiplier.",
    "_horizontalAlign": 1,
    "_verticalAlign": 1,
    "_fontSize": 20,
