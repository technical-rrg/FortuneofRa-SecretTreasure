  {
    "__type__": "cc.RichText",
    "_name": "",
    "_objFlags": 0,
    "__editorExtras__": {},
    "node": {
      "__id__": 431
    },
    "_enabled": true,
    "__prefab": {
      "__id__": 435
    },
    "_lineHeight": 55,
    "_string": "6 spins are awarded.\nAll <img src = '11' height=50 offset=5/> appearing on the triggering spin are held during the bonus.\nIf 1 or more <img src = '12' height=50 offset=5/> land on screen, each <img src = '12' height=50 offset=5/> will display the sum of all credit values displayed on the triggering symbols.\nAfter all <img src = '12' height=50 offset=5/> have been evaluated, each <img src = '13' height=50 offset=5/> that landed on screen for the current spin is evaluated one at a time.\n<img src = '13' height=50 offset=5/> displays the sum of all credit values currently displayed on held positions.\nEach <img src = '12' height=50 offset=5/> and <img src = '13' height=50 offset=5/> that land will be held for the remainder of the bonus.\nEach spin, if the number of spins played is 12 or fewer, “+1 Spin” may appear on a random position that is not held.\n“+1 Spin” awards 1 additional spin.\nIf all 15 positions are held, the value displayed in the Grand Jackpot meter is awarded.\nRemaining spins will be played only if there is at least 1 position not covered by <img src = '11' height=50 offset=5/> , <img src = '12' height=50 offset=5/> , or <img src = '13' height=50 offset=5/>.\nAll symbols other than “+1 Spin”, <img src = '12' height=50 offset=5/>, and <img src = '13' height=50 offset=5/> appearing on the reels will be grayed out and are not evaluated.\nAn alternate set of reels is used during the Top Up Bonus.\n<img src = '11' height=50 offset=5/> does not appear on the reels during the Top Up Bonus. Bonus spins do not award additional bonuses.",
    "_horizontalAlign": 1,
    "_verticalAlign": 1,
    "_fontSize": 20,
    "_fontColor": {
      "__type__": "cc.Color",
      "r": 255,
      "g": 255,
      "b": 255,
      "a": 255
    },
