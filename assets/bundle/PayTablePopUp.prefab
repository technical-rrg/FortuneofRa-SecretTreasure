  {
    "__type__": "cc.RichText",
    "_name": "",
    "_objFlags": 0,
    "__editorExtras__": {},
    "node": {
      "__id__": 397
    },
    "_enabled": true,
    "__prefab": {
      "__id__": 401
    },
    "_lineHeight": 80,
    "_string": "8 free games are awarded.\nIf at least 1 <img src = '12' height=50 offset=15/> appears on screen, then the sum of all values displayed on the triggering symbols is awarded for each <img src = '12' height=50 offset=15/> on screen.\nAn alternate set of reels is used during the Free Games Bonus. Winning combinations for these reels are identical to the base game, except <img src = '11' height=50 offset=15/> and <img src = '10' height=50 offset=15/> do not appear.\n<img src = '12' height=50 offset=15/> only appears on reels 2–4 and is WILD for all symbols except <img src = '11' height=50 offset=15/>.\nThe “Shou Bonus” during the Free Games Bonus is the cumulative awards of all <img src = '12' height=50 offset=15/> and the sum of all values displayed on each <img src = '11' height=50 offset=15/> during the base game.\nThe “Shou Bonus” does not include any jackpots awarded.",
    "_horizontalAlign": 1,
    "_verticalAlign": 1,
    "_fontSize": 20,
    "_fontColor": {
      "__type__": "cc.Color",
      "r": 255,
      "g": 255,
